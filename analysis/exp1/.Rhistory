# Use a consistent dark/light blue palette for the side-specific parameter plots.
accumulator_colors <- c(
A_dark = "#1f4e79",
A_light = "#9ecae1",
v_dark = "#1f4e79",
v_light = "#9ecae1"
)
build_lba_parameter_plot <- function(param_table, model_name) {
# Build three charts: A pair, b, and v pair, then combine them into one figure.
condition_levels <- levels(param_table$condition)
make_base_theme <- function() {
theme_minimal() +
theme(
axis.text.x = element_text(angle = 45, hjust = 1),
panel.grid.major.x = element_blank()
)
}
a_plot <- NULL
if (all(c("A_dark", "A_light") %in% names(param_table))) {
a_table <- param_table %>%
select(condition, A_dark, A_light) %>%
pivot_longer(
cols = c(A_dark, A_light),
names_to = "parameter",
values_to = "value"
) %>%
mutate(condition = factor(as.character(condition), levels = condition_levels))
a_plot <- ggplot(a_table, aes(x = condition, y = value, fill = parameter)) +
geom_col(position = position_dodge(width = 0.8), width = 0.7) +
scale_fill_manual(values = accumulator_colors[c("A_dark", "A_light")]) +
labs(
title = model_name,
x = NULL,
y = "A",
fill = NULL
) +
make_base_theme() +
theme(
axis.text.x = element_blank(),
axis.ticks.x = element_blank()
)
} else if ("A" %in% names(param_table)) {
a_table <- param_table %>%
transmute(condition, value = A) %>%
mutate(condition = factor(as.character(condition), levels = condition_levels))
a_plot <- ggplot(a_table, aes(x = condition, y = value)) +
geom_col(fill = "steelblue", width = 0.7) +
labs(
title = model_name,
x = NULL,
y = "A"
) +
make_base_theme() +
theme(
axis.text.x = element_blank(),
axis.ticks.x = element_blank()
)
}
b_plot <- NULL
if ("b" %in% names(param_table)) {
b_table <- param_table %>%
transmute(condition, value = b) %>%
mutate(condition = factor(as.character(condition), levels = condition_levels))
b_plot <- ggplot(b_table, aes(x = condition, y = value)) +
geom_col(fill = "steelblue", width = 0.7) +
labs(
title = model_name,
x = NULL,
y = "b"
) +
make_base_theme() +
theme(
axis.text.x = element_blank(),
axis.ticks.x = element_blank()
)
}
v_plot <- NULL
if (all(c("v_dark", "v_light") %in% names(param_table))) {
v_table <- param_table %>%
select(condition, v_dark, v_light) %>%
pivot_longer(
cols = c(v_dark, v_light),
names_to = "parameter",
values_to = "value"
) %>%
mutate(condition = factor(as.character(condition), levels = condition_levels))
v_plot <- ggplot(v_table, aes(x = condition, y = value, fill = parameter)) +
geom_col(position = position_dodge(width = 0.8), width = 0.7) +
scale_fill_manual(values = accumulator_colors[c("v_dark", "v_light")]) +
labs(
title = model_name,
x = "Condition",
y = "v",
fill = NULL
) +
make_base_theme()
}
wrap_plots(
Filter(Negate(is.null), list(a_plot, b_plot, v_plot)),
ncol = 1
)
}
